  "serviceType": "AI-Powered Search Engine Optimization"
}
</script>

<!-- Hero -->
<section class="page-hero">
  <div class="container">
    <span class="section-tag">AI-Powered SEO</span>
    <h1>AI-Powered SEO. <span class="gradient-text">Human-Directed Strategy</span>.</h1>
    <p>We use AI to work 10x faster, not to replace expertise. The result: enterprise-level SEO at a fraction of the cost. Every decision is human-made. Every output is human-approved.</p>
    <a href="/contact/" class="btn btn-primary btn-lg">Get Your Free SEO Audit &#8594;</a>
  </div>
</section>

<!-- How We Use AI -->
<section class="how-section">
  <div class="container">
    <span class="section-tag">Our Approach</span>
    <h2 class="section-title" style="text-align:center;">How We Use AI in SEO</h2>
    <p class="section-sub">AI handles the heavy lifting so our strategists can focus on what actually moves your business forward.</p>
    <div class="how-grid">
      <div class="how-card fade-in">
        <span class="how-number">1</span>
        <h3>AI-Assisted Content Production</h3>
        <p>Generate research-backed first drafts, optimize for target keywords, and scale to 10x the volume of traditional agencies. Every piece is reviewed and edited by our team before publishing.</p>
      </div>
      <div class="how-card fade-in">
        <span class="how-number">2</span>
        <h3>Automated Technical Audits</h3>
        <p>AI crawls your entire site and identifies technical issues in minutes instead of days. Broken links, missing schema, Core Web Vitals problems, crawl errors, and mobile issues surfaced instantly.</p>
      </div>
      <div class="how-card fade-in">
        <span class="how-number">3</span>
        <h3>Competitive Intelligence</h3>
        <p>AI-powered analysis of competitor content gaps, keyword opportunities, and ranking strategies. We know exactly where your competitors are weak and where you can win.</p>
      </div>
      <div class="how-card fade-in">
        <span class="how-number">4</span>
        <h3>Schema Generation</h3>
        <p>Automated structured data creation for every page: Organization, LocalBusiness, Service, FAQPage, BreadcrumbList, and industry-specific schema. AI builds it, our team validates it.</p>
      </div>
      <div class="how-card fade-in">
        <span class="how-number">5</span>
        <h3>AEO Integration</h3>
        <p>Every SEO engagement includes answer engine optimization built in. We do not just optimize for Google. We optimize for ChatGPT, Perplexity, and Google AI Overviews simultaneously. <a href="/aeo-services/" style="color:var(--indigo);font-weight:600;">Learn about our AEO framework &#8594;</a></p>
      </div>
    </div>
  </div>
</section>

<!-- What We Do / Don't Do -->
<section class="dont-section">
  <div class="container">
    <h2 class="section-title" style="text-align:center;">What We Do — and What We Refuse to Do</h2>
    <p class="section-sub" style="max-width:720px;margin:0 auto 48px;text-align:center;color:var(--text-muted);font-size:1.1rem;line-height:1.7;">AI is a tool. How you use it determines whether it builds trust or destroys it.</p>
    <div class="dont-grid">
      <div class="dont-col do-col fade-in">
        <h3>What We Do</h3>
        <ul>
          <li>Use AI to accelerate research and first drafts</li>
          <li>Human-review and edit every piece of content</li>
          <li>Run AI-powered technical audits for speed</li>
          <li>Build proprietary automation pipelines</li>
          <li>Integrate AEO into every SEO engagement</li>
          <li>Focus AI on volume so humans focus on strategy</li>
        </ul>
      </div>
      <div class="dont-col no-col fade-in">
        <h3>What We Refuse to Do</h3>
        <ul>
          <li>Mass-produce garbage content for keyword stuffing</li>
          <li>Automate strategy decisions without human judgment</li>
          <li>Publish AI-generated content without expert review</li>
          <li>Sacrifice quality for volume</li>
          <li>Use AI as a shortcut instead of a force multiplier</li>
          <li>Overpromise results based on AI hype</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- The GullStack Difference -->
<section class="diff-section">
  <div class="container">
    <span class="section-tag">The Difference</span>
    <h2 class="section-title" style="text-align:center;">Enterprise Results. Agency Prices.</h2>
    <p class="section-sub">AI makes us faster. Experience makes us effective. The combination means you get results that used to require a six-figure agency budget.</p>
    <div class="diff-stats fade-in">
      <div>
        <span class="diff-stat-number">10x</span>
        <span class="diff-stat-label">Content production speed</span>
      </div>
      <div>
        <span class="diff-stat-number">1/3</span>
        <span class="diff-stat-label">The cost of traditional agencies</span>
      </div>
      <div>
        <span class="diff-stat-number">100%</span>
        <span class="diff-stat-label">Human-reviewed output</span>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="faq-section">
  <div class="container">
    <h2 class="section-title" style="text-align:center;">Frequently Asked Questions</h2>
    <div class="faq-list">
      {% for faq in faqs %}
      <div class="faq-item">
        <button class="faq-question">
          <span>{{ faq.q }}</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">{{ faq.a }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="container">
    <div class="cta-box fade-in">
      <h2>See What AI-Powered SEO <span class="gradient-text">Can Do for You</span></h2>
      <p>Get a free audit of your current SEO performance and see exactly how our AI-powered approach can accelerate your results.</p>
      <a href="/contact/" class="btn btn-primary btn-lg">Get Your Free SEO Audit &#8594;</a>
    </div>
  </div>
</section>
