  }
  .chat-send:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(79,70,229,0.3);
  }

  /* ═══════════════════════════════════════════
     TRUSTED BY
  ═══════════════════════════════════════════ */
  .trusted-section {
