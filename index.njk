<script>
(function() {
  const options = document.querySelectorAll('.chat-option');
  const chatBody = document.querySelector('.chat-body');
  const chatInput = document.getElementById('chatInput');
  const chatSend = document.getElementById('chatSend');

  function handleSelection(value, text) {
    // Visual feedback
    options.forEach(o => o.classList.remove('selected'));
    event.target.classList.add('selected');

    // After brief delay, show response
    setTimeout(() => {
      const responseMap = {
        'website': "A website that actually converts visitors into customers? That's exactly what we build. Let's talk about what your business needs.",
        'visibility': "Getting found on Google and AI search engines is our specialty. We call it AEO — Answer Engine Optimization. Let's get you visible.",
        'fees': "Most small businesses lose $6K-18K/year on disconnected tools and high processing fees. We consolidate everything and cut fees to 1%.",
        'leads': "More leads start with better visibility and a website that works. We've helped businesses go from invisible to 3,000+ monthly searches.",
        'help': "That's exactly why we're here. Let us look at your business and show you the fastest path to growth."
      };

      const optionsEl = document.getElementById('chatOptions');
      const promptEl = document.querySelector('.chat-prompt');
      if (optionsEl) optionsEl.style.display = 'none';
      if (promptEl) promptEl.style.display = 'none';

      // Show user message
      const userBubble = document.createElement('div');
      userBubble.style.cssText = 'background:rgba(168,85,247,0.15);border:1px solid rgba(168,85,247,0.2);border-radius:16px 16px 4px 16px;padding:12px 16px;margin-bottom:12px;font-size:0.9rem;text-align:right;color:var(--text);';
      userBubble.textContent = text || value;
      chatBody.appendChild(userBubble);

      // Show bot response
      setTimeout(() => {
        const botBubble = document.createElement('div');
        botBubble.className = 'chat-bubble';
        botBubble.innerHTML = (responseMap[value] || "Interesting! Let's dig into that.") + '<br><br><a href="/contact/" style="color:#a855f7;font-weight:600;">Book a free consultation →</a>';
        chatBody.appendChild(botBubble);
      }, 800);
    }, 300);
  }

  options.forEach(btn => {
    btn.addEventListener('click', function(e) {
      handleSelection(this.getAttribute('data-value'), this.textContent);
    });
  });

  chatSend.addEventListener('click', () => {
    const val = chatInput.value.trim();
    if (val) handleSelection('custom', val);
  });

  chatInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      const val = chatInput.value.trim();
      if (val) handleSelection('custom', val);
    }
  });
})();
</script>

