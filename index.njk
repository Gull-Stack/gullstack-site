---

<!-- Hero with Salt Lake background -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid">
    <div class="hero-text">
      <div class="hero-tag">Marketing + AI Workforce Platform</div>
      <h1>While You Sleep, Your AI Workforce <span class="gradient-text">Runs Your Business</span></h1>
      <p>The only agency that builds your marketing AND deploys your AI workforce. Websites, SEO, and a team of AI employees that work 24/7 &mdash; so you don't have to.</p>
      <div class="hero-sleep-ticker" id="heroTicker" style="font-size:0.95rem;color:var(--cyan);margin-bottom:24px;min-height:1.5em;font-weight:500;">While you sleep, your AI workforce is triaging 50+ emails...</div>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/services/" class="btn btn-primary btn-lg">Grow Your Business</a>
        <a href="/ai-workforce/" class="btn btn-outline btn-lg">Scale Your Operations</a>
      </div>
    </div>

    <div class="chat-widget">
      <div class="chat-header">
        <div class="chat-avatar">B</div>
        <div>
          <div class="chat-name">Bogey</div>
          <div class="chat-status">Online</div>
        </div>
      </div>
      <div class="chat-body" id="chatBody">
        <div class="chat-bubble">
          What's the #1 thing holding your business back right now?
        </div>
      </div>
      <div class="chat-footer">
        <input type="text" class="chat-input" placeholder="Type here..." id="chatInput">
        <button class="chat-send" id="chatSend">Send</button>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  const chatBody = document.getElementById('chatBody');
  const chatInput = document.getElementById('chatInput');
  const chatSend = document.getElementById('chatSend');
  let msgCount = 0;
  let userEmail = null;
  let emailGateActive = false;
  let chatHistory = [];
  let auditDone = false;

  function extractUrl(text) {
    // Match URLs with or without protocol
    const match = text.match(/(?:https?:\/\/)?(?:www\.)?([a-zA-Z0-9][-a-zA-Z0-9]*\.)+[a-zA-Z]{2,}(?:\/\S*)?/i);
    return match ? match[0] : null;
  }

  function scoreColor(score) {
    if (score >= 80) return '#22c55e';
    if (score >= 50) return '#eab308';
    return '#ef4444';
  }

  function renderAuditCard(audit) {
    const { scores, speed, seoIssues, mobileIssues, hasStructuredData } = audit;
    let html = `<div style="background:rgba(10,10,26,0.6);border:1px solid rgba(79,70,229,0.3);border-radius:12px;padding:16px;margin:8px 0;">`;
    html += `<div style="font-weight:700;margin-bottom:12px;font-size:0.85rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">Site Audit Results</div>`;
    
    // Score bars
    const scoreItems = [
      { label: 'Performance', val: scores.performance },
      { label: 'SEO', val: scores.seo },
      { label: 'Accessibility', val: scores.accessibility },
    ];
    scoreItems.forEach(s => {
      html += `<div style="margin-bottom:8px;">
        <div style="display:flex;justify-content:space-between;font-size:0.8rem;margin-bottom:4px;">
          <span>${s.label}</span><span style="color:${scoreColor(s.val)};font-weight:700;">${s.val}/100</span>
        </div>
        <div style="background:rgba(255,255,255,0.1);border-radius:4px;height:6px;overflow:hidden;">
          <div style="width:${s.val}%;height:100%;background:${scoreColor(s.val)};border-radius:4px;transition:width 1s ease;"></div>
        </div>
      </div>`;
    });

    // Speed metrics
    if (speed.fcp || speed.lcp) {
      html += `<div style="font-size:0.75rem;opacity:0.6;margin-top:8px;">`;
      if (speed.lcp) html += `Largest paint: ${speed.lcp} · `;
      if (speed.tbt) html += `Blocking: ${speed.tbt} · `;
      if (speed.cls) html += `Layout shift: ${speed.cls}`;
      html += `</div>`;
    }

    // Issues
    const allIssues = [...(seoIssues || []), ...(mobileIssues || [])];
    if (!hasStructuredData) allIssues.push('No structured data (invisible to AI search)');
    if (allIssues.length > 0) {
      html += `<div style="margin-top:10px;font-size:0.8rem;color:#ef4444;">`;
      allIssues.forEach(i => { html += `<div style="margin-bottom:2px;">— ${i}</div>`; });
      html += `</div>`;
    }

    html += `</div>`;
    return html;
  }

  async function runAudit(url) {
    try {
      const resp = await fetch('/api/audit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const data = await resp.json();
      return data;
    } catch (e) {
      return { success: false, error: 'Audit failed to connect.' };
    }
  }

  function showEmailGate() {
    emailGateActive = true;
    chatInput.type = 'email';
    chatInput.placeholder = 'Enter your email to continue...';
    chatInput.value = '';

    const gateBubble = document.createElement('div');
    gateBubble.className = 'chat-bubble';
    gateBubble.innerHTML = "I want to give you a real breakdown — not generic advice. Drop your email and I'll send you a custom analysis for your business. <span style='opacity:0.5;font-size:0.8rem;'>No spam, ever.</span>";
    chatBody.appendChild(gateBubble);
    chatBody.scrollTop = chatBody.scrollHeight;
  }

  function isValidEmail(e) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);
  }

  async function callBogey(userMsg) {
    chatHistory.push({ role: 'user', content: userMsg });
    try {
      const resp = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: chatHistory }),
      });
      const data = await resp.json();
      const reply = data.reply || "Tell me more about your business — what industry are you in and what's the biggest challenge you're facing right now?";
      chatHistory.push({ role: 'assistant', content: reply });
      return reply;
    } catch (e) {
      return "Give me one more shot — hit send again. If I'm still spacing out, drop your info at <a href='/contact/' style='color:#a855f7;font-weight:600;'>gullstack.com/contact</a> and the team will follow up with real answers, not fluff.";
    }
  }

  async function sendMessage() {
    const val = chatInput.value.trim();
    if (!val) return;

    // Handle email capture
    if (emailGateActive) {
      if (!isValidEmail(val)) {
        const errBubble = document.createElement('div');
        errBubble.className = 'chat-bubble';
        errBubble.innerHTML = "<span style='opacity:0.7;'>That doesn't look like an email. Try again.</span>";
        chatBody.appendChild(errBubble);
        chatBody.scrollTop = chatBody.scrollHeight;
        return;
      }
      userEmail = val;
      emailGateActive = false;
      chatInput.type = 'text';
      chatInput.placeholder = 'Type here...';
      chatInput.value = '';

      const userBubble = document.createElement('div');
      userBubble.style.cssText = 'background:rgba(168,85,247,0.15);border:1px solid rgba(168,85,247,0.2);border-radius:16px 16px 4px 16px;padding:12px 16px;margin-bottom:12px;font-size:0.9rem;text-align:right;color:var(--text);';
      userBubble.textContent = val;
      chatBody.appendChild(userBubble);

      // Send lead to API
      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: [{ role: 'user', content: '[LEAD CAPTURED] Email: ' + val + ' — Previous conversation: ' + chatHistory.map(m => m.role + ': ' + m.content).join(' | ') }] }),
      }).catch(() => {});

      // After email capture, call Bogey with full context for a real personalized response
      const typing = document.createElement('div');
      typing.className = 'chat-bubble';
      typing.innerHTML = '<span style="opacity:0.5;">Bogey is thinking...</span>';
      chatBody.appendChild(typing);
      chatBody.scrollTop = chatBody.scrollHeight;

      const summary = chatHistory.map(m => m.role + ': ' + m.content).join(' | ');
      const reply = await callBogey('[The visitor just gave their email: ' + val + '] Based on the conversation so far, give them a specific, actionable recommendation for their business. Be direct. Push them to book a strategy call at /contact/. Previous conversation: ' + summary);
      typing.remove();
      const thanksBubble = document.createElement('div');
      thanksBubble.className = 'chat-bubble';
      thanksBubble.innerHTML = reply + '<br><br><a href="/contact/" style="color:#a855f7;font-weight:600;">Book a free strategy call →</a>';
      chatBody.appendChild(thanksBubble);
      chatBody.scrollTop = chatBody.scrollHeight;
      return;
    }

    // Show user message
    const userBubble = document.createElement('div');
    userBubble.style.cssText = 'background:rgba(168,85,247,0.15);border:1px solid rgba(168,85,247,0.2);border-radius:16px 16px 4px 16px;padding:12px 16px;margin-bottom:12px;font-size:0.9rem;text-align:right;color:var(--text);';
    userBubble.textContent = val;
    chatBody.appendChild(userBubble);
    chatInput.value = '';
    msgCount++;

    // Show typing indicator
    const typing = document.createElement('div');
    typing.className = 'chat-bubble';
    typing.innerHTML = '<span style="opacity:0.5;">Bogey is thinking...</span>';
    chatBody.appendChild(typing);
    chatBody.scrollTop = chatBody.scrollHeight;

    // Check if user dropped a URL — trigger audit
    const detectedUrl = extractUrl(val);
    if (detectedUrl && !auditDone) {
      auditDone = true;
      typing.innerHTML = '<span style="opacity:0.5;">Bogey is analyzing your site...</span>';
      
      const auditData = await runAudit(detectedUrl);
      
      if (auditData.success) {
        // Show the visual audit card
        typing.remove();
        const auditBubble = document.createElement('div');
        auditBubble.className = 'chat-bubble';
        auditBubble.innerHTML = renderAuditCard(auditData);
        chatBody.appendChild(auditBubble);
        chatBody.scrollTop = chatBody.scrollHeight;

        // Now send audit data to Bogey for interpretation
        const auditTyping = document.createElement('div');
        auditTyping.className = 'chat-bubble';
        auditTyping.innerHTML = '<span style="opacity:0.5;">Bogey is thinking...</span>';
        chatBody.appendChild(auditTyping);
        chatBody.scrollTop = chatBody.scrollHeight;

        const auditSummary = `[AUDIT RESULTS for ${detectedUrl}] Performance: ${auditData.scores.performance}/100, SEO: ${auditData.scores.seo}/100, Accessibility: ${auditData.scores.accessibility}/100. Speed: LCP ${auditData.speed.lcp || 'n/a'}, TBT ${auditData.speed.tbt || 'n/a'}, CLS ${auditData.speed.cls || 'n/a'}. SEO issues: ${(auditData.seoIssues||[]).join(', ') || 'none found'}. Mobile issues: ${(auditData.mobileIssues||[]).join(', ') || 'none found'}. Structured data: ${auditData.hasStructuredData ? 'present' : 'MISSING'}. Total issues found: ${auditData.issueCount}. Give the visitor a plain-English breakdown of what this means for their business and what they should fix first. Then offer to build a full roadmap.`;
        
        const reply = await callBogey(auditSummary);
        auditTyping.remove();
        const botBubble = document.createElement('div');
        botBubble.className = 'chat-bubble';
        botBubble.innerHTML = reply;
        chatBody.appendChild(botBubble);
        chatBody.scrollTop = chatBody.scrollHeight;

        // Email gate after audit (they've gotten real value now)
        setTimeout(() => showEmailGate(), 2000);
        return;
      } else {
        // Audit failed — fall through to normal flow
        typing.innerHTML = '<span style="opacity:0.5;">Bogey is thinking...</span>';
      }
    }

    // After 3 messages (increased from 2), gate with email
    if (msgCount >= 3 && !userEmail && !auditDone) {
      const reply = await callBogey(val);
      typing.remove();
      const botBubble = document.createElement('div');
      botBubble.className = 'chat-bubble';
      botBubble.innerHTML = reply;
      chatBody.appendChild(botBubble);
      chatBody.scrollTop = chatBody.scrollHeight;
      setTimeout(() => showEmailGate(), 1500);
      return;
    }

    // Call real Bogey
    let reply = await callBogey(val);
    typing.remove();

    // Safety net: if Bogey's reply after 2+ exchanges doesn't ask for URL/email, append a nudge
    if (msgCount >= 2 && !userEmail && !auditDone) {
      const hasAsk = /url|website|link|email|drop your|send me|share your/i.test(reply);
      if (!hasAsk) {
        reply += '<br><br>Drop your website URL and I\'ll run a free audit right now — I\'ll show you exactly what\'s costing you sales.';
      }
    }

    const botBubble = document.createElement('div');
    botBubble.className = 'chat-bubble';
    botBubble.innerHTML = reply;
    chatBody.appendChild(botBubble);
    chatBody.scrollTop = chatBody.scrollHeight;
  }

  chatSend.addEventListener('click', sendMessage);
  chatInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendMessage();
  });
})();
</script>

<script>
(function() {
  const heroPhrases = [
    'triaging 50+ emails...',
    'writing personalized follow-ups...',
    'preparing tomorrow\'s meetings...',
    'tracking compliance deadlines...',
    'qualifying new leads...',
    'drafting your weekly report...',
    'scheduling client appointments...',
    'monitoring your pipeline...'
  ];
  let hIdx = 0;
  const hEl = document.getElementById('heroTicker');
  if (!hEl) return;
  hEl.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
  setInterval(() => {
    hEl.style.opacity = '0';
    hEl.style.transform = 'translateY(8px)';
    setTimeout(() => {
      hIdx = (hIdx + 1) % heroPhrases.length;
      hEl.textContent = 'While you sleep, your AI workforce is ' + heroPhrases[hIdx];
      hEl.style.opacity = '1';
      hEl.style.transform = 'translateY(0)';
    }, 400);
  }, 3000);
})();
