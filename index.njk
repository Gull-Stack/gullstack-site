  }
  .trusted-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    flex-wrap: wrap;
    opacity: 0.5;
  }
  .trusted-logos img {
    height: 28px;
    width: auto;
    filter: grayscale(1) brightness(2);
    transition: all 0.3s;
  }
  .trusted-logos img:hover {
    filter: grayscale(0) brightness(1);
    opacity: 1;
  }

  /* ═══════════════════════════════════════════
     WHAT WE DO
  ═══════════════════════════════════════════ */
  .services-section {
    padding: 8rem 0;
  }

  /* ═══════════════════════════════════════════
     BY THE NUMBERS
  ═══════════════════════════════════════════ */
  .numbers-section {
    padding: 5rem 0;
    background: linear-gradient(180deg, var(--bg) 0%, rgba(79,70,229,0.04) 50%, var(--bg) 100%);
    border-top: 1px solid var(--border);
  }

  /* ═══════════════════════════════════════════
     CASE STUDY SPOTLIGHT
  ═══════════════════════════════════════════ */
  .spotlight-section {
    padding: 8rem 0;
    border-top: 1px solid var(--border);
  }
  .spotlight-card {
    max-width: 900px;
