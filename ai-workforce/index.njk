<!-- ROI Calculator -->
<section class="roi-section" id="calculator">
  <div class="container">
    <div class="section-header text-center fade-in">
      <span class="section-tag">ROI Calculator</span>
      <h2 class="section-title">See What You'll Save</h2>
      <p class="section-sub" style="margin: 0 auto;">Enter your numbers and see what an AI workforce saves you in real dollars.</p>
    </div>

    <div class="roi-card fade-in">
      <div class="roi-inputs">
        <div class="roi-field">
          <label for="roiHours">Hours you work per week</label>
          <input type="number" id="roiHours" value="60" min="20" max="120">
        </div>
        <div class="roi-field">
          <label for="roiValue">Your hourly value ($)</label>
          <input type="number" id="roiValue" value="150" min="25" max="1000">
        </div>
      </div>
      <div class="roi-results" id="roiResults">
        <div class="roi-savings" id="roiSavings">$156,000</div>
        <div class="roi-detail" id="roiHoursDetail">You'd get back 20 hours/week</div>
        <div class="roi-detail" id="roiWeeklyDetail">That's $3,000/week in reclaimed productivity</div>
        <div class="roi-highlight" id="roiHighlight">Annual savings: $156,000 &mdash; that's a 10x return on your AI team investment</div>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  const hoursInput = document.getElementById('roiHours');
  const valueInput = document.getElementById('roiValue');

  function calculate() {
    const hours = parseInt(hoursInput.value) || 60;
    const value = parseInt(valueInput.value) || 150;
    const savedHours = Math.round(hours * 0.33);
    const weeklySavings = savedHours * value;
    const annualSavings = weeklySavings * 52;
    const roi = Math.round(annualSavings / (4997 * 12));

    document.getElementById('roiSavings').textContent = '$' + annualSavings.toLocaleString();
    document.getElementById('roiHoursDetail').textContent = "You'd get back " + savedHours + " hours/week";
    document.getElementById('roiWeeklyDetail').textContent = "That's $" + weeklySavings.toLocaleString() + "/week in reclaimed productivity";
    document.getElementById('roiHighlight').textContent = "Annual savings: $" + annualSavings.toLocaleString() + " \u2014 that's a " + roi + "x return on your AI team investment";
  }

  hoursInput.addEventListener('input', calculate);
  valueInput.addEventListener('input', calculate);
  calculate();
})();
</script>

