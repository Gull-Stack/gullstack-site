{% if footerStyle == 'simple' %}
<footer class="footer--simple">
  <div class="container">
    <div class="footer-inner">
      <p class="footer-copy">© {{ site.year }} <a href="/">{{ site.fullName }}</a>. All rights reserved.</p>
    </div>
  </div>
</footer>
{% else %}
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <img src="{{ site.logo }}" alt="{{ site.name }}" class="logo-img">
          {{ site.name }}
        </a>
        <p>AI-powered marketing, websites, and business tools for small businesses that want to grow without overpaying.</p>
      </div>

      <div class="footer-col">
        <h4>Marketing Solutions</h4>
        <ul>
          <li><a href="/services/websites/">Websites</a></li>
          <li><a href="/services/seo-aeo/">SEO & AEO</a></li>
          <li><a href="/services/marketing-automation/">Marketing Automation</a></li>
          <li><a href="/services/payment-processing/">Integrated Payments</a></li>
          <li><a href="/services/crm/">CRM & Booking</a></li>
        </ul>
        <h4 style="margin-top: 24px;">AI Workforce</h4>
        <ul>
          <li><a href="/ai-workforce/">AI Bot Teams</a></li>
          <li><a href="/ai-workforce/winchester/">Winchester Showcase</a></li>
          <li><a href="/services/ai-consulting/">AI Consulting</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Industries</h4>
        <ul>
          <li><a href="/industries/therapists/">Therapists</a></li>
          <li><a href="/industries/contractors/">Contractors</a></li>
          <li><a href="/industries/medical-practices/">Medical Practices</a></li>
          <li><a href="/industries/salons-spas/">Salons & Spas</a></li>
          <li><a href="/industries/consultants/">Consultants</a></li>
          <li><a href="/industries/restaurants/">Restaurants</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/case-studies/">Case Studies</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© {{ site.year }} {{ site.fullName }}. All rights reserved.</span>
      <div class="footer-legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
{% endif %}
