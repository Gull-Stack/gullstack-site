layout: base.njk
title: Services — GullStack
description: Custom websites, SEO & AEO, AI consulting, marketing automation, payment processing, CRM, and booking systems. Everything your small business needs to grow — from one partner.
headerStyle: inner
activeNav: services
breadcrumb:
  - name: Services
    url: /services/
css: |
  .services-hero {
    padding: 160px 0 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .services-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 800px; height: 600px;
    background: radial-gradient(circle, rgba(79,70,229,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .services-hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 300;
    max-width: 800px;
    margin: 0 auto 24px;
    position: relative; z-index: 1;
  }
  .services-hero p {
    font-size: 1.2rem; color: var(--text-muted);
    max-width: 600px; margin: 0 auto;
    position: relative; z-index: 1; line-height: 1.7;
  }
  .services-grid-section { padding: 0 0 8rem; }
  .service-card-lg {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 40px;
    transition: all var(--transition);
    display: block;
  }
  .service-card-lg:hover {
    border-color: var(--indigo);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(79,70,229,0.15);
  }
  .service-card-lg .icon {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    color: var(--purple); margin-bottom: 24px;
  }
  .service-card-lg .icon svg { width: 24px; height: 24px; }
  .service-card-lg h3 { font-size: 1.4rem; font-weight: 400; margin-bottom: 12px; }
  .service-card-lg p {
    color: var(--text-muted); font-size: 1rem;
    line-height: 1.7; margin-bottom: 20px;
  }
  .service-card-lg .link {
    color: var(--indigo-hover); font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex; align-items: center; gap: 6px;
    transition: gap 0.2s;
  }
  .service-card-lg:hover .link { gap: 10px; }
  @media (max-width: 768px) {
    .service-card-lg[style] { grid-column: span 1 !important; }
  }
---

