    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 800px; height: 600px;
    background: radial-gradient(circle, rgba(79,70,229,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    max-width: 800px;
    margin: 0 auto 24px;
    position: relative; z-index: 1;
  }
  .page-hero p {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 40px;
    position: relative; z-index: 1;
    line-height: 1.7;
  }
  .page-hero .btn { position: relative; z-index: 1; }

  .problem-section { padding: 80px 0; }
  .problem-section .section-title { margin-bottom: 16px; }
  .problem-section .section-sub {
    max-width: 700px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .highlight-box {
    max-width: 720px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(239,68,68,0.08), rgba(239,68,68,0.03));
    border: 1px solid rgba(239,68,68,0.2);
    border-radius: 20px;
    padding: 40px;
  }
  .highlight-box ul {
    margin: 0; padding-left: 20px;
    color: var(--text-muted); line-height: 1.8; font-size: 1.05rem;
  }
  .highlight-box li { margin-bottom: 12px; }

  .solution-section { padding: 80px 0; }
  .solution-section .section-title { margin-bottom: 16px; }
  .solution-section .section-sub {
    max-width: 700px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .solution-copy {
    max-width: 760px;
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .solution-copy p { margin-bottom: 20px; }

  .features-section { padding: 80px 0; }
  .features-section .section-title { margin-bottom: 48px; }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
